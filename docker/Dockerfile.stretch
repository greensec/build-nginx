# Local build environment for build-nginx (CI uses debian:<dist> directly).
FROM debian:stretch

RUN sed -i -e '/stretch-updates/d' \
        -e 's|deb\.debian\.org/debian-security|archive.debian.org/debian-security|g' \
        -e 's|deb\.debian\.org/debian|archive.debian.org/debian|g' \
        -e 's|security\.debian\.org/debian-security|archive.debian.org/debian-security|g' \
        /etc/apt/sources.list \
 && sed -i '/stretch-backports/d' /etc/apt/sources.list \
 && echo "deb http://archive.debian.org/debian stretch-backports main" \
        >>/etc/apt/sources.list \
 && apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential devscripts quilt dpkg-dev debhelper lsb-release \
    libssl-dev libpcre2-dev zlib1g-dev apt-transport-https \
    git ca-certificates curl make xsltproc lintian libxml2-utils fakeroot \
 && apt-get install -y -t stretch-backports debhelper \
 && install -m0755 -d /etc/apt/keyrings \
 && curl -fsSL https://deb.freexian.com/extended-lts/archive-key.gpg \
        -o /etc/apt/keyrings/freexian-elts.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/freexian-elts.gpg] https://deb.freexian.com/extended-lts stretch-lts main contrib non-free" \
        >/etc/apt/sources.list.d/freexian-elts.list \
 && apt-get update -qq \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /nginx-build
ENTRYPOINT ["./scripts/build.sh"]
